_Static_assert( sizeof(shell_strings) / sizeof(shell_strings[0]) < 1024, "shell translation hash table is full" );

static const char *shell_translate( const char *text )
{
    static unsigned short slots[1024];
    static int built;
    unsigned int hash = 2166136261u, i, n = sizeof(shell_strings) / sizeof(shell_strings[0]);
    const unsigned char *c;

    if (shell_language == APP_LANG_EN || !text || !text[0]) return text;
    if (!built)
    {
        for (i = 0; i < n; i++)
        {
            unsigned int h = 2166136261u;

            for (c = (const unsigned char *)shell_strings[i][0]; *c; c++) h = (h ^ *c) * 16777619u;
            for (h &= 1023; slots[h]; h = (h + 1) & 1023) {}
            slots[h] = (unsigned short)(i + 1);
        }
        built = 1;
    }
    for (c = (const unsigned char *)text; *c; c++) hash = (hash ^ *c) * 16777619u;
    for (hash &= 1023; slots[hash]; hash = (hash + 1) & 1023)
    {
        const char *const *row = shell_strings[slots[hash] - 1];
        if (!strcmp( row[APP_LANG_EN], text )) return row[shell_language] ? row[shell_language] : text;
    }
    return text;
}
