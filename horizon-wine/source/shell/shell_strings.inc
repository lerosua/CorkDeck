/* Keys are translated before layout; formatted strings are translated before interpolation. */
static int shell_language;   /* enum app_language */

static enum app_language shell_language_from_code( const char *code )
{
    if (!strcmp( code, "ru" )) return APP_LANG_RU;
    if (!strcmp( code, "zh-CN" ) || !strcmp( code, "zh-Hans" ) ||
        !strcmp( code, "zh-TW" ) || !strcmp( code, "zh-Hant" )) return APP_LANG_ZH_CN;
    return APP_LANG_EN;
}

